# Full-stack Nanitics compose — environment variables.
#
# Copy this file to `.env` and fill in your API key. `.env` is gitignored.
#
# Provider selection — `NANITICS_LLM_PROVIDER` picks which client to
# construct; the matching API key below must be set. Exactly one of
# `ANTHROPIC_API_KEY` / `OPENAI_API_KEY` must be set and it must match
# `NANITICS_LLM_PROVIDER`. Both defaults below are opinionated (not
# required) — swap them for any other supported provider/model.
NANITICS_LLM_PROVIDER=anthropic
NANITICS_LLM_MODEL=claude-haiku-4-5-20251001

# Anthropic API key — required when NANITICS_LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# OpenAI API key — required when NANITICS_LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# Postgres credentials — used by both the `postgres` service and the
# `app` service. The local defaults are development values; production
# deployments must override `POSTGRES_PASSWORD` at minimum.
POSTGRES_USER=nanitics
POSTGRES_PASSWORD=nanitics-local
POSTGRES_DB=nanitics

# App port override. The compose maps `${APP_PORT}:8000`. Defaults to
# 8000 when unset. Uncomment to change.
# APP_PORT=8000

# SQL-analyst runner — sandbox Postgres role credentials. The runner's
# `run_sql` tool authenticates as this role (not the app's privileged
# user); grants are SELECT-only on the analyst tables. Production
# deployments must override `NANITICS_SQL_ANALYST_SANDBOX_PASSWORD`.
NANITICS_SQL_ANALYST_SANDBOX_USER=sql_analyst_sandbox
NANITICS_SQL_ANALYST_SANDBOX_PASSWORD=sandbox-local

# Auction-routed request handling runner — the four specialists bid on
# every incoming request with calibrated confidences and grounded
# per-call cost. The auction always allocates to the
# highest-confidence specialist (with the cheaper bid winning on strict
# ties), so the runner has no env-var knobs.
